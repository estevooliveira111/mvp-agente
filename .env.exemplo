# ==========================================
# GERAL
# ==========================================
# 'development' libera padrões inseguros (senhas/segredos fixos). Em produção, use 'production'.
ENVIRONMENT=development

# ==========================================
# CONFIGURAÇÕES DA IA E MODELOS (LLM)
# ==========================================
# Preencha só a chave do provedor que for usar. Se houver mais de uma, a ordem de
# prioridade é: OpenAI > Anthropic > Ollama (se OLLAMA_MODEL estiver definido) > Gemini.
# Sem nenhuma, cai no Ollama local.

# Chave da OpenAI (GPT-4o). Deve começar com 'sk-'.
OPENAI_API_KEY=

# Chave da Anthropic (Claude Opus 5)
ANTHROPIC_API_KEY=

# Chave do Google Gemini (gemini-2.5-flash)
GEMINI_API_KEY=

# Ollama local (modelos open-source, sem chave)
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# CONFIGURAÇÕES DOS CANAIS (MENSAGERIA)
# ==========================================
# Token do Bot criado no @BotFather no Telegram
TELEGRAM_BOT_TOKEN=0000000000:AAH_SeuTokenTelegramAqui_xyz

# URL pública da API. Usada para registrar o webhook do Telegram.
# Deixe vazia para usar o ngrok: com 'make dev', a API descobre a URL do túnel sozinha.
WEBHOOK_URL=
# API local do ngrok, consultada quando WEBHOOK_URL está vazia.
NGROK_API_URL=http://localhost:4040
# Porta da API (app.py). Se mudar, rode 'make dev API_PORT=<porta>'.
API_PORT=8080

# Segredo que o Telegram devolve em cada update. Fora de 'development', sem ele o
# webhook recusa tudo. Gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=SeuSegredoDoWebhookAqui

# ==========================================
# E-MAIL (SMTP) - usado pela ferramenta email_sender
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==========================================
# DESTINATÁRIOS PERMITIDOS DAS FERRAMENTAS DE ENVIO
# ==========================================
# Qualquer pessoa que fala com o bot pode pedir um envio, então o agente só manda para
# quem estiver aqui (separado por vírgula). Vazio = envio desligado.
# E-mail: endereços completos ou domínios com '@'.
EMAIL_ALLOWED_RECIPIENTS=
# EMAIL_ALLOWED_RECIPIENTS=eu@exemplo.com,@minhaempresa.com
# Telegram: chat_ids numéricos ou @usernames de canal.
TELEGRAM_ALLOWED_CHAT_IDS=

# ==========================================
# BANCO DE DADOS RELACIONAL (POSTGRESQL)
# ==========================================
# Configurações do Docker-Compose
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=mvp_agente
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==========================================
# MEMÓRIA VETORIAL (CHROMADB) E CACHE
# ==========================================
# Opcionais: sem eles, o agente funciona só com o histórico recente.
# ChromaDB: memória de longo prazo (lembranças de conversas antigas do mesmo usuário).
# Memcached: deduplicação dos webhooks e cache da detecção de intenção.
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# ==========================================
# SEGURANÇA E SISTEMA
# ==========================================
# Única pasta que a ferramenta file_read pode ler (relativa à raiz do projeto).
FILE_READ_BASE_DIR=data/files

# Nível de Log no console (DEBUG, INFO, WARNING, ERROR). O arquivo em logs/ sempre registra DEBUG.
LOG_LEVEL=INFO
DISCORD_BOT_TOKEN=

# ==========================================
# AUTENTICAÇÃO (JWT) DAS ROTAS REST
# ==========================================
# Chave secreta usada para assinar os tokens JWT das rotas /api/v1/chat.
# Gere uma com: openssl rand -hex 32
JWT_SECRET_KEY=SuaChaveSecretaJWTAqui

# Validade do token de acesso, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60
